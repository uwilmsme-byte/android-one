<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 태블릿 이름(SCREEN_ID) 등 설정값을 앱 재설치와 무관하게 남는 공용 외부 저장소에도
         백업해두기 위한 권한 — 실제 겪은 문제: "재빌드/재설치할 때마다 태블릿 이름을 매번
         다시 설정해야 함"(SharedPreferences는 "데이터 지우고 설치" 방식 재설치 시 삭제됨).
         구버전 WRITE_EXTERNAL_STORAGE만으로는 Android 10+ 범위저장소 제한에 걸려서
         MANAGE_EXTERNAL_STORAGE가 필요하다 — 관리자 설정의 "설정 백업 저장소 허용"
         버튼으로 사용자가 직접 켜야 한다(Play 스토어 배포가 아닌 사내 사이드로드 앱이라
         이 권한 사용에 제약이 없음). 허용 안 해도 앱은 정상 동작하고(SharedPreferences만
         쓰는 기존 방식), 재설치 후 자동 복구만 안 된다. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- 예약 태블릿(/pt/reserve)의 실시간 통역 마이크(getUserMedia/네이티브 녹음)를
         웹뷰가 승인할 수 있으려면 이 선언이 있어야 한다. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 화면전환 명령(open_contact/open_reservation/return_to_dentweb) 폴링을 이 앱이
         백그라운드(=덴트웹 앱이 앞에 나와있는 동안)일 때도 계속하기 위한 포그라운드 서비스
         (CommandPollService) — 실제 요청 사항: "접수, 혹은 예약 화면을 열면 덴트웹 접수
         화면에서 /pt, /pt/reservation으로 화면이 전환되도록". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 덴트웹 환자용 앱이 실제로 전면에 있는지 확인하기 위한 특수 권한 — 일반 런타임
         권한창으로는 요청 불가, 관리자 설정의 "전면 앱 확인 권한 허용" 버튼으로 사용자가
         설정 > 앱 > 특수 접근 > 사용정보 접근에서 직접 허용해야 한다. 허용 안 해도 앱은
         정상 동작하고(마지막으로 내린 명령 기준 추정치로 폴백), 정확도만 낮아진다. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- 안드로이드 10+ "백그라운드 활동 시작 제한" 때문에 CommandPollService(포그라운드
         서비스)가 화면전환을 시도해도 조용히 막힐 수 있었다(실제 겪은 문제: 상태는
         성공으로 찍히는데 실제 화면은 안 바뀜). 이 권한으로 안 보이는 1x1 오버레이 창을
         계속 띄워두면("보이는 창이 있음" 예외 조건 충족) startActivity()가 더 안정적으로
         통과한다 — 관리자 설정의 "다른 앱 위에 표시 허용" 버튼으로 사용자가 직접 켜야 한다
         (공장초기화/기기소유자 지정 불필요, 설정 토글 하나로 끝남). -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 안드로이드 11+ 패키지 가시성(Package Visibility) 제한 — 이걸 선언 안 하면 다른 앱은
         우리한테 아예 "존재하지 않는" 것처럼 보여서 packageManager.getLaunchIntentForPackage()가
         항상 null을 반환한다(실제 로그로 확인된 원인 — logcat: "AppsFilter: interaction:
         ... -> PackageSetting{... kr.co.DentWeb.DentWebCustomer ...} BLOCKED"). 오버레이/
         백그라운드 실행 제한과는 별개의, 더 근본적인 차단 원인이었다.
         DENTWEB_PACKAGE를 관리자 설정에서 다른 값으로 바꾸면 이 목록도 같이 바꿔야 한다
         (queries는 컴파일 타임 선언이라 런타임 설정만으로는 안 풀림). -->
    <queries>
        <package android:name="kr.co.DentWeb.DentWebCustomer" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="HUBONE Agent"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".SettingsActivity"
            android:screenOrientation="landscape" />
        <activity
            android:name=".MainActivity"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".HubOneModeWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/hubone_mode_widget_info" />
        </receiver>
        <!-- 절전(sleep) 명령용 — HubOneDeviceAdminReceiver 참고. android:permission
             선언이 필수(시스템만 이 리시버를 호출할 수 있게 강제). -->
        <receiver
            android:name=".HubOneDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin_policies" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <service
            android:name=".CommandPollService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="hubone_agent_kiosk_screen_command_polling" />
        </service>
    </application>
</manifest>
